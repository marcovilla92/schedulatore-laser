# File di esempio per la configurazione delle variabili d'ambiente.
# Copia questo file come `.env` (stessa cartella) e riempi i valori.
# Il file .env è già ignorato da git (vedi app/.gitignore).

# ─── GEMINI (LLM fallback per cartigli DXF non standard) ───────────────
# Ottieni una API key GRATUITA (1500 richieste/giorno free tier):
# https://aistudio.google.com/apikey
# Se non configurata, il fallback LLM è disabilitato silenziosamente
# e il parser usa solo tabelle regex + descrizioni cartiglio.
GEMINI_API_KEY=

# ─── EMAIL / SMTP (invio PDF preventivo al cliente) ───────────────────
# Server di posta in uscita della casella aziendale (info@carpenterials.it).
# Se non configurato, il pulsante "Invia al cliente" offre comunque di segnare
# il preventivo come inviato senza spedire la mail.
#
# Aruba (tipico per domini .it):   host=smtps.aruba.it  porta=465  sicurezza=ssl
# Gmail / Google Workspace:        host=smtp.gmail.com  porta=587  sicurezza=starttls
#                                  (serve una "password per app", non quella normale)
# Microsoft 365 / Outlook:         host=smtp.office365.com  porta=587  sicurezza=starttls
#
# SMTP_HOST=
# SMTP_PORT=465
# SMTP_USER=info@carpenterials.it
# SMTP_PASSWORD=
# SMTP_SECURITY=ssl
# SMTP_FROM=info@carpenterials.it
# SMTP_FROM_NAME=Carpenteria L.S. S.r.l.

# ─── BACKUP ───────────────────────────────────────────────────────────
# Intervallo backup database SQLite (secondi, default 3600 = 1 ora)
# BACKUP_INTERVALLO_SECONDI=3600

# Intervallo export JSON ordini (secondi, default 86400 = 24 ore)
# EXPORT_INTERVALLO_SECONDI=86400

# ─── FINE TURNO ───────────────────────────────────────────────────────
# Orario chiusura automatica scan officina (HH:MM, default 17:30)
# Può essere modificato anche via tab admin senza restart.
# FINE_TURNO_HHMM=17:30

# ─── DEBUG FLASK ──────────────────────────────────────────────────────
# Solo per sviluppo, MAI in produzione (espone stack trace).
# FLASK_DEBUG=false
