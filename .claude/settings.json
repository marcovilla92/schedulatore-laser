{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/gsd-check-update.js"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash(git commit*)",
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/gsd-quality-gate.js"
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "node .claude/hooks/gsd-statusline.js"
  },
  "permissions": {
    "allow": [
      "Bash(python app/run.py*)",
      "Bash(python -m pytest*)",
      "Bash(python -m py_compile*)",
      "Bash(pip install*)",
      "Bash(curl http://localhost:5000*)",
      "Bash(git status*)",
      "Bash(git add*)",
      "Bash(git commit*)",
      "Bash(git log*)",
      "Bash(git diff*)",
      "Bash(git rev-parse*)",
      "Bash(git push*)",
      "Bash(npx playwright*)",
      "Bash(node .claude/*)",
      "Bash(chmod +x*)",
      "Bash(bash .claude/commands/scripts/*)",
      "Bash(date*)",
      "Bash(ls*)",
      "Bash(mkdir*)",
      "Read(.claude/**)",
      "Read(.planning/**)",
      "Write(.claude/**)",
      "Write(.planning/**)"
    ]
  },
  "mcpServers": {
    "sqlite": {
      "command": "npx",
      "args": [
        "-y",
        "@anthropic-ai/mcp-server-sqlite",
        "app/database/scheduler.db"
      ]
    },
    "fetch": {
      "command": "npx",
      "args": ["-y", "@anthropic-ai/mcp-server-fetch"]
    },
    "chrome-devtools": {
      "command": "npx",
      "args": ["chrome-devtools-mcp@latest"]
    }
  }
}
